{
  "name": "@wess/atlas",
  "private": true,
  "version": "0.4.2",
  "description": "Composable Bun/TypeScript packages for building APIs, full-stack apps, and CLI tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wess/atlas.git"
  },
  "homepage": "https://wess.io/atlas/",
  "bugs": "https://github.com/wess/atlas/issues",
  "keywords": [
    "bun",
    "typescript",
    "framework",
    "api",
    "fullstack",
    "functional",
    "http-server",
    "websocket",
    "auth",
    "oauth",
    "database",
    "cli",
    "agents",
    "llm",
    "mcp"
  ],
  "files": [
    "web/packages",
    "web/docs",
    "web/llms.txt",
    "web/templates"
  ],
  "exports": {
    "./admin": "./web/packages/admin/index.ts",
    "./ai": "./web/packages/ai/index.ts",
    "./auth": "./web/packages/auth/index.ts",
    "./auth/social": "./web/packages/auth/social/index.ts",
    "./billing": "./web/packages/billing/index.ts",
    "./cache": "./web/packages/cache/index.ts",
    "./cli": "./web/packages/cli/index.ts",
    "./config": "./web/packages/config/index.ts",
    "./db": "./web/packages/db/index.ts",
    "./edge": "./web/packages/edge/index.ts",
    "./email": "./web/packages/email/index.ts",
    "./mcp": "./web/packages/mcp/index.ts",
    "./migrate": "./web/packages/migrate/index.ts",
    "./oauth": "./web/packages/oauth/index.ts",
    "./request": "./web/packages/request/index.ts",
    "./request/providers": "./web/packages/request/providers/index.ts",
    "./security": "./web/packages/security/index.ts",
    "./server": "./web/packages/server/index.ts",
    "./server/sse": "./web/packages/server/sse/index.ts",
    "./server/ws": "./web/packages/server/ws/index.ts",
    "./share": "./web/packages/share/index.ts",
    "./sso": "./web/packages/sso/index.ts",
    "./storage": "./web/packages/storage/index.ts",
    "./ui": "./web/packages/ui/index.ts",
    "./ui/*": "./web/packages/ui/*/index.tsx",
    "./packages/*": "./web/packages/*",
    "./social": "./web/packages/social/index.ts",
    "./admin/ui": "./web/packages/admin/ui/index.ts",
    "./auth/password": "./web/packages/auth/password/index.ts",
    "./auth/token": "./web/packages/auth/token/index.ts",
    "./auth/session": "./web/packages/auth/session/index.ts",
    "./auth/flows": "./web/packages/auth/flows/index.ts",
    "./db/query": "./web/packages/db/query.ts",
    "./db/postgres": "./web/packages/db/postgres/index.ts",
    "./db/sqlite": "./web/packages/db/sqlite/index.ts",
    "./db/changeset": "./web/packages/db/changeset/index.ts",
    "./storage/signing": "./web/packages/storage/signing/index.ts",
    "./cli/command": "./web/packages/cli/command/index.ts",
    "./cli/foreman": "./web/packages/cli/foreman/index.ts",
    "./cli/scaffold": "./web/packages/cli/scaffold/index.ts",
    "./cli/docs": "./web/packages/cli/docs/index.ts",
    "./cli/entry": "./web/packages/cli/entry.ts",
    "./mcp/entry": "./web/packages/mcp/entry.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "typescript": ">=7.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "lucide-react": "^1.61.0",
    "@mantine/core": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@tanstack/react-table": "^9.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "@mantine/core": {
      "optional": true
    },
    "@mantine/hooks": {
      "optional": true
    },
    "@mantine/form": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "type": "module",
  "bin": {
    "atlas": "./web/packages/cli/entry.ts"
  }
