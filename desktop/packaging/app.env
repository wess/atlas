# What this app is called, everywhere it has to be named. Every packaging
# script and CI job reads this file, so a rename is one edit rather than a
# grep across shell, PowerShell, WiX, and three YAML workflows.
#
# Sourced by bash (`. packaging/app.env`) and parsed by PowerShell and the
# release workflow, so keep it to plain KEY="value" lines with no expansion.

# Display name: the .app bundle, the window title, the menu bar.
APP_NAME="__APPNAME__"
# Lowercase identity: the shipped binary, ~/.<slug>, the .deb, the icon file.
APP_SLUG="__APPSLUG__"
# The bundle identifier, and the macOS preferences domain.
APP_ID="__APPID__"
# One line. Appears in the .deb, the .desktop entry, and both Windows manifests.
APP_DESC="__APPDESC__"
# owner/repo — where releases are published and the updater looks.
APP_REPO="__APPREPO__"
# The env-var prefix: <APP_ENV>_RELEASE marks a release build, <APP_ENV>_DIR
# relocates the app's state directory.
APP_ENV="__APPENV__"
APP_AUTHOR="__APPAUTHOR__"

# LSApplicationCategoryType, for the App Store category the Finder shows.
APP_CATEGORY="public.app-category.developer-tools"
APP_MIN_MACOS="11.0"

# Debian section and the freedesktop menu categories.
APP_LINUX_SECTION="utils"
APP_LINUX_CATEGORIES="Development;Utility;"

# The icon accent, used by scripts/icon.sh to render the placeholder master.
APP_ACCENT="#4C6EF5"
